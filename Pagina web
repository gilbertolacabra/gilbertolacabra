<!-- ══════════ SCRIPT ══════════ -->
<script>
/* ─── GAME DATA ─── */
let GAMES = [
  {id:'snake',title:'Snake',description:'El clásico juego de la serpiente. Come la comida, crece y evita chocarte.',category:'Arcade',emoji:'🐍',color:'g-snake',thumb:'t-snake',available:true,vip:false,tags:['clásico','arcade','serpiente','retro'],instructions:'Flechas del teclado o WASD para mover. Espacio para pausar.'},
  {id:'shadowfighters',title:'Shadow Fighters',description:'Juego de peleas estilo sombras con combates intensos.',category:'Acción',emoji:'🥷',color:'g-space',thumb:'t-space',available:true,vip:false,tags:['peleas','acción','shadow'],instructions:'Usa el teclado para jugar.'},
  {id:'vip_racer',title:'Turbo Racer VIP',description:'Carreras de alta velocidad con pistas exclusivas. Solo para miembros VIP.',category:'Racing',emoji:'🏎️',color:'g-vip1',thumb:'t-vip1',available:true,vip:true,tags:['vip','carreras','velocidad','exclusivo'],instructions:'Flechas para conducir. Evita obstáculos y gana la carrera.'},
  {id:'vip_rpg',title:'Dark Dungeon VIP',description:'RPG de mazmorras con combates por turnos y items épicos. Exclusivo VIP.',category:'RPG',emoji:'⚔️',color:'g-vip2',thumb:'t-vip2',available:true,vip:true,tags:['vip','rpg','mazmorra','épico'],instructions:'Haz clic para atacar y explorar la mazmorra.'},
  {id:'tetris',title:'Tetris',description:'El legendario juego de piezas. Encaja los bloques para completar líneas.',category:'Puzzle',emoji:'🟦',color:'g-tetris',thumb:'t-tetris',available:false,vip:false,tags:['clásico','puzzle','bloques','retro']},
  {id:'pong',title:'Pong',description:'El primer videojuego de la historia. Rebota la pelota y vence a tu oponente.',category:'Arcade',emoji:'🏓',color:'g-pong',thumb:'t-pong',available:false,vip:false,tags:['clásico','deportes','2 jugadores','retro']},
  {id:'memory',title:'Memory',description:'Pon a prueba tu memoria. Encuentra todos los pares de cartas.',category:'Puzzle',emoji:'🃏',color:'g-memory',thumb:'t-memory',available:false,vip:false,tags:['memoria','puzzle','cartas']},
  {id:'space',title:'Space Invaders',description:'Defiende la Tierra de los invasores alienígenas. Dispara y esquiva.',category:'Acción',emoji:'👾',color:'g-space',thumb:'t-space',available:false,vip:false,tags:['acción','disparos','aliens','retro']},
  {id:'flappy',title:'Flappy Bird',description:'Mantén al pájaro volando entre los tubos. Un solo toque para volar.',category:'Arcade',emoji:'🐦',color:'g-flappy',thumb:'t-flappy',available:false,vip:false,tags:['arcade','pájaro','adictivo']},
];

const CATEGORIES = ['Todos','Arcade','Puzzle','Acción','Racing','RPG','Estrategia'];

/* ─── AUTH STATE ─── */
function getUsers(){
  const users = JSON.parse(localStorage.getItem('gz_users')||'[]');
  // Ensure admin always exists
  const hasAdmin = users.some(u=>u.email==='admin@gamezone.com');
  if(!hasAdmin){
    users.push({id:'admin_001',username:'Admin',email:'admin@gamezone.com',password:'admin123',vip:false,isAdmin:true,joinDate:new Date().toISOString()});
    saveUsers(users);
  }
  return users;
}
function saveUsers(u){localStorage.setItem('gz_users',JSON.stringify(u))}
function getCurrentUser(){return JSON.parse(localStorage.getItem('gz_current')||'null')}
function setCurrentUser(u){localStorage.setItem('gz_current',JSON.stringify(u))}
function clearCurrentUser(){localStorage.removeItem('gz_current')}
function getVipLogs(){return JSON.parse(localStorage.getItem('gz_vip_logs')||'[]')}
function saveVipLogs(l){localStorage.setItem('gz_vip_logs',JSON.stringify(l))}

/* ─── FILTER STATE ─── */
let state={search:'',category:'Todos',onlyAvailable:false};

function filtered(){
  return GAMES.filter(g=>{
    const q=state.search.toLowerCase();
    const matchSearch=!q||g.title.toLowerCase().includes(q)||g.description.toLowerCase().includes(q)||(g.tags||[]).some(t=>t.toLowerCase().includes(q));
    const matchCat=state.category==='Todos'||g.category===state.category;
    const matchAvail=!state.onlyAvailable||g.available;
    return matchSearch&&matchCat&&matchAvail;
  });
}

/* ─── RENDER ─── */
function render(){renderPills();renderGrid();renderQuickPlay();updateResultsHeader();updateHeroStats();renderVipBanner();updateHeaderAuth()}

function renderVipBanner(){
  const u=getCurrentUser();
  const el=document.getElementById('vipBannerContainer');
  if(u&&u.vip){
    el.innerHTML=`<div class="vip-active-card"><div class="vip-active-left"><div class="vip-active-icon">👑</div><div class="vip-active-text"><h3>Membresía VIP Activa</h3><p>Bienvenido, ${u.username}. Tienes acceso a todos los juegos exclusivos.</p></div></div><div class="vip-stars">⭐⭐⭐</div></div>`;
  } else {
    el.innerHTML=`<div class="vip-banner"><div class="vip-banner-left"><div class="vip-banner-icon">👑</div><div><div class="vip-banner-text"><h3>Hazte miembro VIP</h3><p>Desbloquea juegos exclusivos y beneficios premium</p></div><div class="vip-features" style="margin-top:8px"><span class="vip-feat">🎮 Juegos exclusivos</span><span class="vip-feat">⚡ Acceso anticipado</span><span class="vip-feat">🏆 Badge VIP</span></div></div></div><button class="btn-vip" onclick="handleVipClick()">Ver VIP →</button></div>`;
  }
}

function updateHeaderAuth(){
  const u=getCurrentUser();
  const authEl=document.getElementById('headerAuth');
  const profileEl=document.getElementById('headerProfile');
  if(u){
    authEl.classList.add('hidden');
    profileEl.classList.remove('hidden');
    const initials=u.username.charAt(0).toUpperCase();
    const av=document.getElementById('profileAvatar');
    av.textContent=initials;
    av.className='profile-avatar'+(u.isAdmin?' admin':u.vip?' vip':'');
    document.getElementById('profileName').textContent=u.username;
    const roleEl=document.getElementById('profileRole');
    roleEl.textContent=u.isAdmin?'🛡️ Admin':u.vip?'👑 VIP':'Free';
    roleEl.className='profile-role'+(u.isAdmin?' admin':u.vip?' vip':'');
    document.getElementById('dropdownName').textContent=u.username;
    document.getElementById('dropdownEmail').textContent=u.email;
    const vipBadge=document.getElementById('dropdownVipBadge');
    const adminBadge=document.getElementById('dropdownAdminBadge');
    const adminBtn=document.getElementById('adminPanelBtn');
    if(u.isAdmin){
      adminBadge.classList.remove('hidden');
      adminBtn.classList.remove('hidden');
      vipBadge.classList.add('hidden');
    } else {
      adminBadge.classList.add('hidden');
      adminBtn.classList.add('hidden');
      u.vip?vipBadge.classList.remove('hidden'):vipBadge.classList.add('hidden');
    }
  } else {
    authEl.classList.remove('hidden');
    profileEl.classList.add('hidden');
  }
}

function renderPills(){
  const c=document.getElementById('pillsContainer');
  c.innerHTML=CATEGORIES.map(cat=>{
    const count=cat==='Todos'?GAMES.length:GAMES.filter(g=>g.category===cat).length;
    const active=state.category===cat;
    return `<button class="pill${active?' active':''}" onclick="setCategory('${cat}')">${cat}<span class="pill-count">${count}</span></button>`;
  }).join('');
}

function renderGrid(){
  const list=filtered();
  const grid=document.getElementById('gameGrid');
  const empty=document.getElementById('emptyState');
  if(list.length===0){grid.innerHTML='';grid.style.display='none';empty.style.display='flex';return}
  empty.style.display='none';grid.style.display='grid';
  grid.innerHTML=list.map(g=>cardHTML(g)).join('');
}

function cardHTML(g){
  const u=getCurrentUser();
  const isVipLocked=g.vip&&(!u||!u.vip)&&!(u&&u.isAdmin);
  const thumbDiv=`<div class="card-thumb-placeholder ${g.thumb}">${g.emoji}</div>`;
  const overlayDiv=`<div class="card-thumb-overlay ${g.thumb}"></div>`;
  let badge='';
  if(g.vip){badge=`<span class="card-badge vip-badge">👑 VIP</span>`;}
  else if(g.available){badge=`<span class="card-badge" style="background:rgba(30,41,59,.9);color:var(--muted)">${g.category}</span>`;}
  else{badge=`<span class="card-badge" style="background:rgba(30,41,59,.9);color:var(--muted2)">${g.category}</span>`;}
  let lockOrSoon='';
  if(isVipLocked){lockOrSoon=`<div class="card-lock"><span>🔒</span><p>Solo VIP</p></div>`;}
  else if(!g.available){lockOrSoon=`<div class="card-soon"><span>Próximamente</span></div>`;}
  const playBtn=g.available&&!isVipLocked
    ?`<button class="card-play ${g.vip?'card-play-vip':''}" style="${!g.vip?'background:linear-gradient(135deg,'+getGradColors(g.color)+')':''}" onclick="openGame('${g.id}')">${g.vip?'👑 Jugar (VIP)':'▶ Jugar ahora'}</button>`
    :isVipLocked?`<button class="card-play card-play-vip" onclick="handleVipClick()">🔒 Activar VIP</button>`:'';
  const tags=(g.tags||[]).slice(0,3).map(t=>`<span class="card-tag">#${t}</span>`).join('');
  const cardClass=`game-card ${isVipLocked?'vip-locked':(g.available?'available':'unavailable')}${g.vip?' vip-card':''}`;
  return `<div class="${cardClass}" ${g.available&&!isVipLocked?`onclick="openGame('${g.id}')"`:''}><div class="card-thumb">${thumbDiv}${overlayDiv}${badge}<span class="card-emoji">${g.emoji}</span>${lockOrSoon}</div><div class="card-body"><div class="card-title">${g.title}</div><div class="card-desc">${g.description}</div><div class="card-tags">${tags}</div>${playBtn}</div></div>`;
}

function getGradColors(c){
  const m={'g-snake':'#22c55e,#059669','g-space':'#06b6d4,#0284c7','g-tetris':'#3b82f6,#4338ca','g-pong':'#f97316,#d97706','g-memory':'#a855f7,#7c3aed','g-flappy':'#eab308,#f97316'};
  return m[c]||'#7c3aed,#06b6d4';
}

function renderQuickPlay(){
  const available=GAMES.filter(g=>g.available);
  const el=document.getElementById('quickGrid');
  el.innerHTML=available.map(g=>{
    const u=getCurrentUser();
    const isVipLocked=g.vip&&(!u||!u.vip)&&!(u&&u.isAdmin);
    return `<button class="quick-card ${g.color}${g.vip?' vip-quick':''}" onclick="${isVipLocked?'handleVipClick()':'openGame(\''+g.id+'\')'}">${g.vip?`<span class="quick-vip-tag">VIP</span>`:''}<span class="quick-emoji">${g.emoji}</span><div class="quick-info"><h4>${g.title}</h4><p>${g.category}</p></div><span class="quick-arrow">→</span></button>`;
  }).join('');
}

function updateResultsHeader(){
  const list=filtered();
  document.getElementById('resultsTitle').textContent=state.search?`Resultados para "${state.search}"`:state.category!=='Todos'?state.category:'Todos los juegos';
  document.getElementById('resultsCount').textContent=`${list.length} juego${list.length!==1?'s':''} encontrado${list.length!==1?'s':''}`;
}

function updateHeroStats(){
  const av=GAMES.filter(g=>g.available).length;
  const dev=GAMES.filter(g=>!g.available).length;
  document.getElementById('availableCount').textContent=`${av} juego${av!==1?'s':''} disponible${av!==1?'s':''}`;
  document.getElementById('devCount').textContent=`${dev} en desarrollo`;
}

/* ─── FILTERS ─── */
function setCategory(cat){state.category=cat;render()}
function clearFilters(){state={search:'',category:'Todos',onlyAvailable:false};document.getElementById('searchInput').value='';document.getElementById('availableBtn').classList.remove('active');render()}

document.getElementById('searchInput').addEventListener('input',function(){
  state.search=this.value;
  document.getElementById('clearSearch').classList.toggle('hidden',!this.value);
  render();
});
document.getElementById('clearSearch').addEventListener('click',function(){
  state.search='';document.getElementById('searchInput').value='';this.classList.add('hidden');render();
});
document.getElementById('availableBtn').addEventListener('click',function(){
  state.onlyAvailable=!state.onlyAvailable;this.classList.toggle('active',state.onlyAvailable);render();
});

/* ─── DROPDOWN ─── */
let dropdownOpen=false;
function toggleDropdown(){
  dropdownOpen=!dropdownOpen;
  document.getElementById('profileDropdown').classList.toggle('hidden',!dropdownOpen);
}
document.addEventListener('click',e=>{
  if(!e.target.closest('#headerProfile'))closeDropdown();
});
function closeDropdown(){dropdownOpen=false;document.getElementById('profileDropdown').classList.add('hidden');}

/* ─── AUTH ─── */
function openAuthModal(tab='login'){
  document.getElementById('authBackdrop').style.display='flex';
  switchAuthTab(tab);
}
function closeAuthModal(){document.getElementById('authBackdrop').style.display='none';}
function switchAuthTab(tab){
  document.getElementById('loginForm').classList.toggle('hidden',tab!=='login');
  document.getElementById('registerForm').classList.toggle('hidden',tab!=='register');
  document.getElementById('tabLogin').classList.toggle('active',tab==='login');
  document.getElementById('tabRegister').classList.toggle('active',tab==='register');
}
document.getElementById('authBackdrop').addEventListener('click',e=>{if(e.target===document.getElementById('authBackdrop'))closeAuthModal()});

function doLogin(){
  const email=document.getElementById('loginEmail').value.trim();
  const pass=document.getElementById('loginPassword').value;
  const errEl=document.getElementById('loginError');
  errEl.style.display='none';
  if(!email||!pass){errEl.textContent='Completa todos los campos';errEl.style.display='block';return}
  // Check admin
  if(email==='admin@gamezone.com'&&pass==='admin123'){
    const adminUser={id:'admin_001',username:'Admin',email:'admin@gamezone.com',vip:false,isAdmin:true,joinDate:new Date().toISOString()};
    setCurrentUser(adminUser);
    // ensure admin in users list
    let users=getUsers();
    if(!users.some(u=>u.email==='admin@gamezone.com')){
      users.push({...adminUser,password:'admin123'});
      saveUsers(users);
    }
    closeAuthModal();
    render();
    showToast('🛡️ Bienvenido, Administrador','admin-toast');
    return;
  }
  const users=getUsers();
  const user=users.find(u=>u.email===email&&u.password===pass);
  if(!user){errEl.textContent='Email o contraseña incorrectos';errEl.style.display='block';return}
  setCurrentUser(user);
  closeAuthModal();
  render();
  showToast(`¡Bienvenido, ${user.username}! 🎮`,'success');
}

function doRegister(){
  const username=document.getElementById('regUsername').value.trim();
  const email=document.getElementById('regEmail').value.trim();
  const pass=document.getElementById('regPassword').value;
  const errEl=document.getElementById('registerError');
  errEl.style.display='none';
  if(!username||!email||!pass){errEl.textContent='Completa todos los campos';errEl.style.display='block';return}
  if(pass.length<6){errEl.textContent='La contraseña debe tener al menos 6 caracteres';errEl.style.display='block';return}
  const users=getUsers();
  if(users.some(u=>u.email===email)){errEl.textContent='Este email ya está registrado';errEl.style.display='block';return}
  const newUser={id:'u_'+Date.now(),username,email,password:pass,vip:false,isAdmin:false,joinDate:new Date().toISOString()};
  users.push(newUser);
  saveUsers(users);
  setCurrentUser(newUser);
  closeAuthModal();
  render();
  showToast(`¡Cuenta creada! Bienvenido, ${username} 🎮`,'success');
}

function logout(){
  clearCurrentUser();
  closeDropdown();
  render();
  showToast('Sesión cerrada. ¡Hasta pronto!');
}

/* ─── VIP ─── */
function handleVipClick(){
  const u=getCurrentUser();
  if(!u){openAuthModal('login');return}
  openVipModal();
}
function openVipModal(){document.getElementById('vipBackdrop').style.display='flex'}
function closeVipModal(){document.getElementById('vipBackdrop').style.display='none'}
document.getElementById('vipBackdrop').addEventListener('click',e=>{if(e.target===document.getElementById('vipBackdrop'))closeVipModal()});

function activateVip(){
  const u=getCurrentUser();
  if(!u){closeVipModal();openAuthModal('login');return}
