/* ─── ADMIN ACTIONS ─── */
function toggleUserVip(userId,giveVip){
  const users=getUsers();
  const idx=users.findIndex(u=>u.id===userId);
  if(idx===-1)return;
  users[idx].vip=giveVip;
  saveUsers(users);
  // Update if current user
  const cu=getCurrentUser();
  if(cu&&cu.id===userId){cu.vip=giveVip;setCurrentUser(cu);}
  // Update VIP logs
  if(giveVip){
    const logs=getVipLogs();
    if(!logs.some(l=>l.userId===userId&&l.active)){
      logs.push({userId,username:users[idx].username,email:users[idx].email,amount:4.99,date:new Date().toISOString(),active:true});
      saveVipLogs(logs);
    }
  }
  showToast(giveVip?`👑 VIP otorgado a ${users[idx].username}`:`VIP retirado de ${users[idx].username}`,'admin-toast');
  refreshAdminData();
  render();
}

function deleteUser(userId){
  if(!confirm('¿Eliminar este usuario? Esta acción no se puede deshacer.'))return;
  let users=getUsers();
  const user=users.find(u=>u.id===userId);
  users=users.filter(u=>u.id!==userId);
  saveUsers(users);
  const cu=getCurrentUser();
  if(cu&&cu.id===userId){clearCurrentUser();render();}
  showToast(`Usuario ${user?.username||''} eliminado`,'admin-toast');
  refreshAdminData();
}

function toggleVipLog(idx,active){
  const logs=getVipLogs();
  const realIdx=logs.length-1-idx;
  if(logs[realIdx])logs[realIdx].active=active;
  saveVipLogs(logs);
  // Also update user vip status
  if(!active){
    const users=getUsers();
    const uIdx=users.findIndex(u=>u.id===logs[realIdx]?.userId);
    if(uIdx>-1){users[uIdx].vip=false;saveUsers(users);const cu=getCurrentUser();if(cu&&cu.id===users[uIdx].id){cu.vip=false;setCurrentUser(cu);render();}}
  }
  showToast(active?'VIP reactivado':'VIP cancelado','admin-toast');
  refreshAdminData();
}

function toggleGameAvailability(idx){
  GAMES[idx].available=!GAMES[idx].available;
  showToast(`${GAMES[idx].title}: ${GAMES[idx].available?'Activado':'Desactivado'}`,'admin-toast');
  refreshAdminData();
  render();
}

function toggleGameVip(idx){
  GAMES[idx].vip=!GAMES[idx].vip;
  showToast(`${GAMES[idx].title}: ${GAMES[idx].vip?'Ahora es VIP':'Ya no es VIP'}`,'admin-toast');
  refreshAdminData();
  render();
}

function editGame(idx){
  const g=GAMES[idx];
  document.getElementById('gameFormContainer').innerHTML=`
    <div class="admin-form">
      <h3>✏️ Editar: ${g.title}</h3>
      <div class="admin-form-grid">
        <div class="form-group"><label>Título</label><input type="text" id="ef_title" value="${g.title}"></div>
        <div class="form-group"><label>Categoría</label>
          <select id="ef_cat">${CATEGORIES.filter(c=>c!=='Todos').map(c=>`<option value="${c}"${g.category===c?' selected':''}>${c}</option>`).join('')}</select>
        </div>
        <div class="form-group"><label>Emoji</label><input type="text" id="ef_emoji" value="${g.emoji}" maxlength="4"></div>
        <div class="form-group"><label>Descripción</label><input type="text" id="ef_desc" value="${g.description}"></div>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:12px">
        <div class="toggle-switch" onclick="toggleField('ef_available')" id="ef_available_wrap">
          <div class="toggle-track${g.available?' on':''}" id="ef_available_track"><div class="toggle-thumb"></div></div>
          <span class="toggle-label">Disponible</span>
        </div>
        <div class="toggle-switch" onclick="toggleField('ef_vip')" id="ef_vip_wrap">
          <div class="toggle-track${g.vip?' on':''}" id="ef_vip_track"><div class="toggle-thumb"></div></div>
          <span class="toggle-label">Exclusivo VIP</span>
        </div>
      </div>
      <div class="admin-form-actions">
        <button class="btn-save" onclick="saveGameEdit(${idx})">💾 Guardar cambios</button>
        <button class="btn-cancel" onclick="document.getElementById('gameFormContainer').innerHTML=''">Cancelar</button>
      </div>
    </div>`;
}

function toggleField(id){
  const track=document.getElementById(id+'_track');
  track.classList.toggle('on');
}

function saveGameEdit(idx){
  GAMES[idx].title=document.getElementById('ef_title').value||GAMES[idx].title;
  GAMES[idx].category=document.getElementById('ef_cat').value;
  GAMES[idx].emoji=document.getElementById('ef_emoji').value||GAMES[idx].emoji;
  GAMES[idx].description=document.getElementById('ef_desc').value||GAMES[idx].description;
  GAMES[idx].available=document.getElementById('ef_available_track').classList.contains('on');
  GAMES[idx].vip=document.getElementById('ef_vip_track').classList.contains('on');
  document.getElementById('gameFormContainer').innerHTML='';
  showToast(`${GAMES[idx].title} actualizado ✓`,'success');
  refreshAdminData();
  render();
}

function showAddGameForm(){
  document.getElementById('gameFormContainer').innerHTML=`
    <div class="admin-form">
      <h3>➕ Agregar nuevo juego</h3>
      <div class="admin-form-grid">
        <div class="form-group"><label>Título *</label><input type="text" id="nf_title" placeholder="Nombre del juego"></div>
        <div class="form-group"><label>Categoría</label>
          <select id="nf_cat">${CATEGORIES.filter(c=>c!=='Todos').map(c=>`<option value="${c}">${c}</option>`).join('')}</select>
        </div>
        <div class="form-group"><label>Emoji</label><input type="text" id="nf_emoji" placeholder="🎮" maxlength="4"></div>
        <div class="form-group"><label>Descripción</label><input type="text" id="nf_desc" placeholder="Descripción breve..."></div>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:12px">
        <div class="toggle-switch" onclick="toggleField('nf_available')">
          <div class="toggle-track on" id="nf_available_track"><div class="toggle-thumb"></div></div>
          <span class="toggle-label">Disponible</span>
        </div>
        <div class="toggle-switch" onclick="toggleField('nf_vip')">
          <div class="toggle-track" id="nf_vip_track"><div class="toggle-thumb"></div></div>
          <span class="toggle-label">Exclusivo VIP</span>
        </div>
      </div>
      <div class="admin-form-actions">
        <button class="btn-save" onclick="saveNewGame()">✨ Crear juego</button>
        <button class="btn-cancel" onclick="document.getElementById('gameFormContainer').innerHTML=''">Cancelar</button>
      </div>
    </div>`;
}

function saveNewGame(){
  const title=document.getElementById('nf_title').value.trim();
  if(!title){showToast('El título es obligatorio','admin-toast');return}
  const newGame={
    id:'game_'+Date.now(),
    title,
    category:document.getElementById('nf_cat').value,
    emoji:document.getElementById('nf_emoji').value||'🎮',
    description:document.getElementById('nf_desc').value||'Nuevo juego',
    available:document.getElementById('nf_available_track').classList.contains('on'),
    vip:document.getElementById('nf_vip_track').classList.contains('on'),
    color:'g-space',thumb:'t-space',tags:[],
    instructions:'Instrucciones próximamente.'
  };
  GAMES.push(newGame);
  document.getElementById('gameFormContainer').innerHTML='';
  showToast(`${newGame.title} agregado ✓`,'success');
  refreshAdminData();
  render();
}

/* ─── TOAST ─── */
let toastTimer=null;
function showToast(msg,type=''){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.className=type?type:'';
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),3000);
}

/* ─── INIT ─── */
getUsers(); // ensure admin exists
render();
</script>
</body>
</html>
