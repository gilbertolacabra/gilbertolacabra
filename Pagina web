<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GameZone 🎮 - Mini Juegos Web</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#020617;--bg2:#0f172a;--bg3:#1e293b;
  --border:#334155;--border2:#475569;
  --text:#f1f5f9;--muted:#94a3b8;--muted2:#64748b;
  --violet:#7c3aed;--violet2:#8b5cf6;
  --cyan:#06b6d4;--green:#22c55e;--yellow:#eab308;--red:#ef4444;
  --gold:#f59e0b;--gold2:#fbbf24;
  --vip-grad:linear-gradient(135deg,#f59e0b,#d97706,#92400e);
  --vip-glow:rgba(245,158,11,.35);
}
html{scroll-behavior:smooth}
body{font-family:'Rajdhani',system-ui,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;
  background-image:radial-gradient(ellipse at 20% 20%,rgba(139,92,246,.13) 0%,transparent 50%),radial-gradient(ellipse at 80% 80%,rgba(6,182,212,.10) 0%,transparent 50%);}
button{cursor:pointer;font-family:inherit;border:none;outline:none}
input,select,textarea{font-family:inherit;outline:none}
img{display:block;width:100%}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}
.hidden{display:none!important}
.pulse{animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
@keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes float{0%,100%{transform:translateY(-50%) rotate(-5deg)}50%{transform:translateY(calc(-50% - 12px)) rotate(5deg)}}
@keyframes vipPulse{0%,100%{box-shadow:0 0 20px var(--vip-glow)}50%{box-shadow:0 0 40px var(--vip-glow),0 0 60px rgba(245,158,11,.15)}}
@keyframes slideIn{from{opacity:0;transform:translateX(100%)}to{opacity:1;transform:translateX(0)}}

/* ─── HEADER ─── */
header{position:sticky;top:0;z-index:40;background:rgba(2,6,23,.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(51,65,85,.6);}
.header-inner{max-width:1280px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:12px;}
.logo{display:flex;align-items:center;gap:10px;flex-shrink:0}
.logo-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#7c3aed,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 8px 24px rgba(124,58,237,.35);}
.logo-text h1{font-size:17px;font-weight:900;line-height:1;font-family:'Orbitron',sans-serif}
.logo-text p{font-size:11px;color:var(--muted);margin-top:2px}
@media(max-width:480px){.logo-text{display:none}}
.search-wrap{position:relative;flex:1;max-width:400px}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:15px;pointer-events:none;color:var(--muted2)}
#searchInput{width:100%;background:rgba(30,41,59,.8);border:1px solid var(--border);border-radius:12px;padding:10px 38px 10px 38px;font-size:14px;color:var(--text);transition:border-color .2s,box-shadow .2s;}
#searchInput::placeholder{color:var(--muted2)}
#searchInput:focus{border-color:var(--violet2);box-shadow:0 0 0 3px rgba(139,92,246,.2)}
#clearSearch{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;color:var(--muted);font-size:14px;padding:4px;transition:color .2s}
#clearSearch:hover{color:var(--text)}
#availableBtn{flex-shrink:0;padding:9px 14px;border-radius:12px;font-size:13px;font-weight:700;border:1px solid var(--border);background:rgba(30,41,59,.8);color:var(--muted);transition:all .2s;}
#availableBtn:hover{color:var(--text);border-color:var(--border2)}
#availableBtn.active{background:var(--violet);border-color:var(--violet2);color:#fff;box-shadow:0 4px 20px rgba(124,58,237,.4)}
.header-auth{display:flex;align-items:center;gap:8px;flex-shrink:0}
.btn-login{padding:9px 16px;border-radius:12px;font-size:13px;font-weight:700;border:1px solid var(--border);background:rgba(30,41,59,.8);color:var(--text);transition:all .2s;}
.btn-login:hover{border-color:var(--violet2);color:var(--violet2)}
.btn-register{padding:9px 16px;border-radius:12px;font-size:13px;font-weight:700;background:var(--violet);color:#fff;transition:all .2s;}
.btn-register:hover{background:var(--violet2);box-shadow:0 4px 16px rgba(124,58,237,.4)}
.profile-btn{display:flex;align-items:center;gap:10px;padding:7px 14px 7px 10px;border-radius:14px;background:rgba(30,41,59,.8);border:1px solid var(--border);color:var(--text);transition:all .2s;position:relative;}
.profile-btn:hover{border-color:var(--border2)}
.profile-avatar{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:900;color:#fff;font-family:'Orbitron',sans-serif;}
.profile-avatar.vip{background:var(--vip-grad);box-shadow:0 0 12px var(--vip-glow);}
.profile-avatar.admin{background:linear-gradient(135deg,#ef4444,#dc2626);box-shadow:0 0 12px rgba(239,68,68,.4);}
.profile-name{font-size:13px;font-weight:700}
.profile-role{font-size:11px;color:var(--muted);line-height:1}
.profile-role.vip{color:var(--gold2)}
.profile-role.admin{color:#f87171}
.profile-chevron{font-size:11px;color:var(--muted2);margin-left:2px}
.profile-dropdown{position:absolute;top:calc(100% + 8px);right:0;background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:8px;min-width:210px;box-shadow:0 20px 60px rgba(0,0,0,.5);z-index:100;animation:fadeIn .15s ease;}
.dropdown-user{padding:10px 12px 12px;border-bottom:1px solid var(--border);margin-bottom:6px}
.dropdown-user-name{font-size:15px;font-weight:800}
.dropdown-user-email{font-size:12px;color:var(--muted2);margin-top:2px}
.dropdown-vip-badge{display:inline-flex;align-items:center;gap:5px;margin-top:8px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.05em;background:var(--vip-grad);color:#fff;}
.dropdown-admin-badge{display:inline-flex;align-items:center;gap:5px;margin-top:8px;padding:4px 10px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.05em;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;}
.dropdown-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:10px;font-size:14px;font-weight:600;color:var(--text);transition:background .15s;width:100%;text-align:left;background:none;}
.dropdown-item:hover{background:var(--bg3)}
.dropdown-item.danger{color:#f87171}
.dropdown-item.danger:hover{background:rgba(239,68,68,.1)}
.dropdown-item.admin-item{color:#f87171}
.dropdown-item.admin-item:hover{background:rgba(239,68,68,.1)}
.dropdown-sep{height:1px;background:var(--border);margin:6px 0}

/* ─── MAIN ─── */
main{max-width:1280px;margin:0 auto;padding:32px 20px 60px}
.hero{position:relative;border-radius:24px;overflow:hidden;border:1px solid rgba(51,65,85,.5);margin-bottom:36px;}
.hero-img{height:220px;width:100%;background:linear-gradient(135deg,#1e1b4b 0%,#0f172a 40%,#042f2e 100%);position:relative;overflow:hidden;}
.hero-img::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 50%,rgba(124,58,237,.4) 0%,transparent 55%),radial-gradient(circle at 75% 30%,rgba(6,182,212,.3) 0%,transparent 45%);}
.hero-stars{position:absolute;inset:0;background-image:radial-gradient(1px 1px at 20% 30%,rgba(255,255,255,.6) 0%,transparent 100%),radial-gradient(1px 1px at 50% 10%,rgba(255,255,255,.5) 0%,transparent 100%),radial-gradient(1px 1px at 70% 60%,rgba(255,255,255,.4) 0%,transparent 100%),radial-gradient(1px 1px at 90% 20%,rgba(255,255,255,.5) 0%,transparent 100%),radial-gradient(2px 2px at 10% 80%,rgba(255,255,255,.3) 0%,transparent 100%),radial-gradient(1px 1px at 35% 70%,rgba(255,255,255,.4) 0%,transparent 100%),radial-gradient(2px 2px at 60% 85%,rgba(255,255,255,.3) 0%,transparent 100%),radial-gradient(1px 1px at 85% 45%,rgba(255,255,255,.5) 0%,transparent 100%);}
.hero-controller{position:absolute;right:40px;top:50%;transform:translateY(-50%);font-size:90px;opacity:.15;animation:float 4s ease-in-out infinite;}
@media(max-width:600px){.hero-controller{display:none}}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to right,rgba(2,6,23,.95) 0%,rgba(2,6,23,.7) 50%,transparent 100%);}
.hero-content{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 36px;}
.hero-label{font-size:11px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--violet2);margin-bottom:6px}
.hero-title{font-size:clamp(28px,5vw,46px);font-weight:900;line-height:1.1;font-family:'Orbitron',sans-serif}
.hero-sub{color:#cbd5e1;font-size:14px;margin-top:8px;max-width:340px}
.hero-stats{display:flex;gap:20px;margin-top:14px;align-items:center}
.hero-stat-live{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.dot-live{width:8px;height:8px;border-radius:50%;background:var(--green)}
.vip-banner{border-radius:20px;overflow:hidden;border:1px solid rgba(245,158,11,.3);margin-bottom:28px;background:linear-gradient(135deg,rgba(245,158,11,.08),rgba(217,119,6,.05),rgba(146,64,14,.08));padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative;animation:vipPulse 3s ease infinite;}
.vip-banner::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}
.vip-banner-left{display:flex;align-items:center;gap:16px}
.vip-banner-icon{font-size:36px;filter:drop-shadow(0 0 12px var(--vip-glow))}
.vip-banner-text h3{font-size:18px;font-weight:900;font-family:'Orbitron',sans-serif;background:linear-gradient(90deg,#fbbf24,#f59e0b,#d97706);background-size:200% auto;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 3s linear infinite;}
.vip-banner-text p{font-size:13px;color:var(--muted);margin-top:3px}
.vip-features{display:flex;gap:12px;flex-wrap:wrap}
.vip-feat{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--gold2);font-weight:600;}
.btn-vip{padding:11px 22px;border-radius:12px;font-size:14px;font-weight:800;background:var(--vip-grad);color:#fff;flex-shrink:0;box-shadow:0 6px 24px var(--vip-glow);transition:opacity .2s,transform .1s;}
.btn-vip:hover{opacity:.9}
.btn-vip:active{transform:scale(.97)}
.pills{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;margin-bottom:20px;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.pill{flex-shrink:0;padding:8px 16px;border-radius:99px;font-size:13px;font-weight:700;border:1px solid var(--border);background:rgba(30,41,59,.7);color:var(--muted);display:flex;align-items:center;gap:6px;transition:all .2s;}
.pill:hover{color:var(--text);border-color:var(--border2)}
.pill.active{background:var(--violet);border-color:var(--violet2);color:#fff;transform:scale(1.05);box-shadow:0 4px 18px rgba(124,58,237,.4)}
.pill-count{font-size:11px;padding:2px 7px;border-radius:99px;background:rgba(255,255,255,.15);color:inherit}
.pill:not(.active) .pill-count{background:var(--bg3);color:var(--muted2)}
.results-header{margin-bottom:20px}
.results-header h3{font-size:17px;font-weight:800}
.results-header p{font-size:13px;color:var(--muted2);margin-top:2px}
#gameGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}
.game-card{background:rgba(15,23,42,.7);border:1px solid rgba(51,65,85,.6);border-radius:18px;overflow:hidden;transition:transform .25s,box-shadow .25s,border-color .25s;position:relative;}
.game-card.available{cursor:pointer}
.game-card.available:hover{transform:scale(1.03);box-shadow:0 20px 60px rgba(0,0,0,.5);border-color:rgba(71,85,105,.9)}
.game-card.unavailable{opacity:.65;cursor:not-allowed}
.game-card.vip-card{border-color:rgba(245,158,11,.3)}
.game-card.vip-card.available:hover{border-color:rgba(245,158,11,.6);box-shadow:0 20px 60px rgba(245,158,11,.15)}
.game-card.vip-locked{cursor:pointer;opacity:.85}
.card-thumb{position:relative;height:170px;overflow:hidden}
.card-thumb-bg{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.game-card.available:hover .card-thumb-bg{transform:scale(1.1)}
.card-thumb-overlay{position:absolute;inset:0;opacity:.45;transition:opacity .3s}
.game-card.available:hover .card-thumb-overlay{opacity:.55}
.card-thumb-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:56px}
.card-badge{position:absolute;top:10px;left:10px;font-size:11px;font-weight:800;padding:3px 10px;border-radius:99px;color:#fff;letter-spacing:.04em;}
.card-badge.vip-badge{background:var(--vip-grad);box-shadow:0 2px 12px var(--vip-glow);}
.card-emoji{position:absolute;bottom:10px;right:10px;font-size:28px;filter:drop-shadow(0 2px 8px rgba(0,0,0,.5))}
.card-soon{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.card-soon span{background:rgba(2,6,23,.8);backdrop-filter:blur(6px);color:#94a3b8;font-size:11px;font-weight:800;padding:6px 16px;border-radius:99px;border:1px solid var(--border);letter-spacing:.12em;text-transform:uppercase;}
.card-lock{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:rgba(2,6,23,.7);backdrop-filter:blur(3px);}
.card-lock span{font-size:32px}
.card-lock p{font-size:12px;font-weight:700;color:var(--gold2)}
.card-body{padding:14px 16px 18px}
.card-title{font-size:17px;font-weight:800}
.card-desc{font-size:13px;color:var(--muted);margin-top:5px;line-height:1.5;display:-webkit-box;-webkit-lineclamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:10px}
.card-tag{font-size:11px;color:var(--muted2);background:rgba(30,41,59,.8);padding:2px 8px;border-radius:99px;border:1px solid rgba(51,65,85,.5)}
.card-play{display:block;width:100%;margin-top:14px;padding:10px;border-radius:12px;font-size:13px;font-weight:800;color:#fff;transition:opacity .2s,transform .1s;}
.card-play:hover{opacity:.9}
.card-play:active{transform:scale(.97)}
.card-play-vip{background:var(--vip-grad);box-shadow:0 4px 16px var(--vip-glow);}
#emptyState{display:none;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;text-align:center}
#emptyState p.big{font-size:56px;margin-bottom:12px}
#emptyState h3{font-size:20px;font-weight:800;color:var(--muted)}
#emptyState p.sub{font-size:13px;color:var(--muted2);margin-top:6px}
#emptyState button{margin-top:18px;padding:10px 22px;background:var(--bg3);border:1px solid var(--border);color:#cbd5e1;border-radius:12px;font-size:13px;font-weight:700;transition:background .2s}
#emptyState button:hover{background:var(--border)}
#quickPlay{margin-top:48px}
#quickPlay h3{font-size:17px;font-weight:800;margin-bottom:16px;display:flex;align-items:center;gap:8px}
#quickPlay h3 span{font-size:13px;font-weight:400;color:var(--muted2)}
.quick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.quick-card{display:flex;align-items:center;gap:16px;padding:20px;border-radius:18px;color:#fff;transition:opacity .2s,transform .1s;position:relative;overflow:hidden;}
.quick-card:hover{opacity:.92}
.quick-card:active{transform:scale(.98)}
.quick-card.vip-quick{border:1px solid rgba(245,158,11,.4)}
.quick-emoji{font-size:44px}
.quick-info h4{font-size:20px;font-weight:900;font-family:'Orbitron',sans-serif}
.quick-info p{font-size:13px;opacity:.7;margin-top:2px}
.quick-arrow{margin-left:auto;font-size:22px;opacity:.5;transition:opacity .2s}
.quick-card:hover .quick-arrow{opacity:1}
.quick-vip-tag{position:absolute;top:10px;right:10px;font-size:10px;font-weight:800;padding:2px 8px;border-radius:99px;background:var(--vip-grad);color:#fff;letter-spacing:.05em;}
footer{border-top:1px solid rgba(51,65,85,.4);padding:28px 20px;text-align:center}
footer p{font-size:13px;color:var(--muted2)}
footer p+p{margin-top:4px;font-size:12px;color:var(--border)}

/* ─── MODALS ─── */
#modalBackdrop{display:none;position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.82);backdrop-filter:blur(14px);align-items:center;justify-content:center;padding:16px;}
#modalBackdrop.show{display:flex}
.modal{position:relative;z-index:10;background:var(--bg2);border:1px solid var(--border);border-radius:24px;width:100%;max-width:580px;max-height:95vh;overflow-y:auto;box-shadow:0 40px 100px rgba(0,0,0,.6);}
.modal-header{padding:20px 22px;border-radius:22px 22px 0 0;display:flex;align-items:center;justify-content:space-between;gap:12px;}
.modal-header-left{display:flex;align-items:center;gap:14px}
.modal-emoji{font-size:40px}
.modal-title{font-size:24px;font-weight:900;font-family:'Orbitron',sans-serif}
.modal-cat{font-size:13px;opacity:.7;margin-top:2px}
.modal-close{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.18);color:#fff;font-size:16px;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s;}
.modal-close:hover{background:rgba(255,255,255,.28)}
.modal-how{background:rgba(0,0,0,.2);border-radius:10px;padding:8px 14px;margin:0 22px 4px;font-size:12px;color:rgba(255,255,255,.75);line-height:1.5;}
.modal-how b{color:#fff}
.modal-body{padding:20px 22px}

/* ─── AUTH MODAL ─── */
.auth-modal{background:var(--bg2);border:1px solid var(--border);border-radius:24px;width:100%;max-width:420px;box-shadow:0 40px 100px rgba(0,0,0,.6);overflow:hidden;position:relative;z-index:10;}
.auth-header{padding:28px 28px 0;text-align:center;}
.auth-header .auth-icon{width:64px;height:64px;border-radius:18px;margin:0 auto 14px;background:linear-gradient(135deg,#7c3aed,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:28px;box-shadow:0 8px 24px rgba(124,58,237,.35);}
.auth-header h2{font-size:22px;font-weight:900;font-family:'Orbitron',sans-serif}
.auth-header p{font-size:14px;color:var(--muted);margin-top:6px}
.auth-tabs{display:flex;gap:2px;margin:20px 28px 0;background:var(--bg3);border-radius:12px;padding:4px;}
.auth-tab{flex:1;padding:9px;border-radius:9px;font-size:13px;font-weight:700;color:var(--muted);background:none;transition:all .2s;}
.auth-tab.active{background:var(--violet);color:#fff;box-shadow:0 4px 12px rgba(124,58,237,.3)}
.auth-form{padding:22px 28px 28px}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:6px;letter-spacing:.08em;text-transform:uppercase}
.form-group input,.form-group select{width:100%;background:rgba(30,41,59,.8);border:1px solid var(--border);border-radius:12px;padding:12px 14px;font-size:14px;color:var(--text);transition:border-color .2s,box-shadow .2s;}
.form-group input::placeholder{color:var(--muted2)}
.form-group input:focus,.form-group select:focus{border-color:var(--violet2);box-shadow:0 0 0 3px rgba(139,92,246,.2)}
.form-group select option{background:var(--bg2)}
.form-error{font-size:12px;color:#f87171;margin-top:6px;display:none}
.btn-auth{width:100%;padding:13px;border-radius:12px;font-size:15px;font-weight:800;color:#fff;background:linear-gradient(135deg,var(--violet),var(--cyan));box-shadow:0 6px 24px rgba(124,58,237,.3);transition:opacity .2s,transform .1s;margin-top:4px;}
.btn-auth:hover{opacity:.9}
.btn-auth:active{transform:scale(.98)}
.auth-switch{text-align:center;margin-top:14px;font-size:13px;color:var(--muted)}
.auth-switch button{background:none;color:var(--violet2);font-weight:700;font-size:13px;text-decoration:underline}
.auth-switch button:hover{color:var(--violet)}

/* ─── VIP MODAL ─── */
.vip-modal{background:var(--bg2);border:1px solid rgba(245,158,11,.3);border-radius:24px;width:100%;max-width:460px;box-shadow:0 40px 100px rgba(0,0,0,.6),0 0 60px var(--vip-glow);overflow:hidden;position:relative;z-index:10;animation:fadeIn .2s ease;}
.vip-modal-header{padding:28px 28px 0;text-align:center;background:linear-gradient(180deg,rgba(245,158,11,.08),transparent);}
.vip-crown{font-size:52px;filter:drop-shadow(0 0 20px var(--vip-glow))}
.vip-modal-title{font-size:24px;font-weight:900;font-family:'Orbitron',sans-serif;background:linear-gradient(90deg,#fbbf24,#f59e0b,#d97706);background-size:200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:shimmer 2s linear infinite;margin-top:10px;}
.vip-modal-sub{font-size:14px;color:var(--muted);margin-top:6px}
.vip-perks{padding:20px 28px}
.vip-perk{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid rgba(51,65,85,.4);}
.vip-perk:last-child{border-bottom:none}
.vip-perk-icon{font-size:22px;flex-shrink:0;margin-top:2px}
.vip-perk-text h4{font-size:14px;font-weight:800;color:var(--gold2)}
.vip-perk-text p{font-size:12px;color:var(--muted);margin-top:2px}
.vip-pricing{margin:0 28px 20px;background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);border-radius:16px;padding:16px;text-align:center;}
.vip-price{font-size:32px;font-weight:900;color:var(--gold2);font-family:'Orbitron',sans-serif}
.vip-price span{font-size:16px;color:var(--muted);font-family:'Rajdhani',sans-serif}
.vip-price-note{font-size:12px;color:var(--muted2);margin-top:4px}
.btn-get-vip{display:block;width:calc(100% - 56px);margin:0 28px 24px;padding:14px;border-radius:14px;font-size:16px;font-weight:900;color:#fff;background:var(--vip-grad);box-shadow:0 8px 28px var(--vip-glow);transition:opacity .2s,transform .1s;text-align:center;}
.btn-get-vip:hover{opacity:.9}
.btn-get-vip:active{transform:scale(.98)}
.vip-note{text-align:center;padding:0 28px 24px;font-size:12px;color:var(--muted2)}
.vip-active-card{background:linear-gradient(135deg,rgba(245,158,11,.12),rgba(217,119,6,.08));border:1px solid rgba(245,158,11,.3);border-radius:20px;padding:20px 24px;margin-bottom:28px;display:flex;align-items:center;justify-content:space-between;gap:16px;position:relative;overflow:hidden;}
.vip-active-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}
.vip-active-left{display:flex;align-items:center;gap:14px}
.vip-active-icon{font-size:32px;filter:drop-shadow(0 0 10px var(--vip-glow))}
.vip-active-text h3{font-size:16px;font-weight:900;font-family:'Orbitron',sans-serif;color:var(--gold2);}
.vip-active-text p{font-size:13px;color:var(--muted);margin-top:2px}
.vip-stars{font-size:18px;letter-spacing:2px}

/* ─── ADMIN PANEL ─── */
#adminBackdrop{display:none;position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.95);backdrop-filter:blur(20px);flex-direction:column;overflow:hidden;}
#adminBackdrop.show{display:flex}
.admin-topbar{background:rgba(15,23,42,.95);border-bottom:1px solid rgba(239,68,68,.2);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.admin-topbar-left{display:flex;align-items:center;gap:14px}
.admin-logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#ef4444,#dc2626);display:flex;align-items:center;justify-content:center;font-size:18px;box-shadow:0 4px 16px rgba(239,68,68,.4);}
.admin-topbar h1{font-size:16px;font-weight:900;font-family:'Orbitron',sans-serif;color:#fff}
.admin-topbar p{font-size:11px;color:#f87171;margin-top:1px}
.admin-close-btn{padding:8px 16px;border-radius:10px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#f87171;font-size:13px;font-weight:700;transition:all .2s;}
.admin-close-btn:hover{background:rgba(239,68,68,.2)}
.admin-layout{display:flex;flex:1;overflow:hidden}
.admin-sidebar{width:220px;background:rgba(15,23,42,.8);border-right:1px solid rgba(51,65,85,.4);padding:16px 12px;flex-shrink:0;overflow-y:auto;}
.admin-nav-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;font-size:14px;font-weight:700;color:var(--muted);transition:all .2s;width:100%;text-align:left;background:none;margin-bottom:4px;}
.admin-nav-item:hover{background:rgba(30,41,59,.8);color:var(--text)}
.admin-nav-item.active{background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.2);}
.admin-nav-icon{font-size:18px}
.admin-nav-label{flex:1}
.admin-nav-count{font-size:11px;padding:2px 8px;border-radius:99px;background:rgba(239,68,68,.2);color:#f87171}
.admin-content{flex:1;overflow-y:auto;padding:24px}
.admin-section{display:none;animation:fadeIn .2s ease}
.admin-section.active{display:block}

/* ─── ADMIN DASHBOARD ─── */
.admin-stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:28px}
.admin-stat-card{background:rgba(15,23,42,.8);border:1px solid var(--border);border-radius:16px;padding:20px;position:relative;overflow:hidden;}
.admin-stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.admin-stat-card.red::before{background:linear-gradient(90deg,#ef4444,#dc2626)}
.admin-stat-card.gold::before{background:linear-gradient(90deg,#f59e0b,#d97706)}
.admin-stat-card.green::before{background:linear-gradient(90deg,#22c55e,#16a34a)}
.admin-stat-card.blue::before{background:linear-gradient(90deg,#3b82f6,#2563eb)}
.admin-stat-icon{font-size:28px;margin-bottom:8px}
.admin-stat-value{font-size:32px;font-weight:900;font-family:'Orbitron',sans-serif}
.admin-stat-card.red .admin-stat-value{color:#f87171}
.admin-stat-card.gold .admin-stat-value{color:var(--gold2)}
.admin-stat-card.green .admin-stat-value{color:#4ade80}
.admin-stat-card.blue .admin-stat-value{color:#60a5fa}
.admin-stat-label{font-size:12px;color:var(--muted);margin-top:4px;font-weight:600}

/* ─── ADMIN TABLE ─── */
.admin-section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px}
.admin-section-header h2{font-size:20px;font-weight:900;font-family:'Orbitron',sans-serif}
.admin-section-header p{font-size:13px;color:var(--muted2);margin-top:2px}
.btn-admin-action{padding:9px 18px;border-radius:10px;font-size:13px;font-weight:700;color:#fff;background:linear-gradient(135deg,#ef4444,#dc2626);border:none;transition:opacity .2s;}
.btn-admin-action:hover{opacity:.85}
.btn-admin-action.green{background:linear-gradient(135deg,#22c55e,#16a34a)}
.btn-admin-action.gold{background:var(--vip-grad)}
.admin-table-wrap{background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.admin-table{width:100%;border-collapse:collapse}
.admin-table th{padding:12px 16px;text-align:left;font-size:11px;font-weight:800;color:var(--muted2);text-transform:uppercase;letter-spacing:.1em;background:rgba(30,41,59,.5);border-bottom:1px solid var(--border)}
.admin-table td{padding:13px 16px;font-size:14px;border-bottom:1px solid rgba(51,65,85,.3)}
.admin-table tr:last-child td{border-bottom:none}
.admin-table tr:hover td{background:rgba(30,41,59,.3)}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:99px;font-size:11px;font-weight:800}
.badge.vip{background:rgba(245,158,11,.15);color:var(--gold2);border:1px solid rgba(245,158,11,.3)}
.badge.free{background:rgba(100,116,139,.15);color:var(--muted);border:1px solid var(--border)}
.badge.admin{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3)}
.badge.active{background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.3)}
.badge.inactive{background:rgba(100,116,139,.15);color:var(--muted);border:1px solid var(--border)}
.tbl-actions{display:flex;gap:6px}
.tbl-btn{padding:5px 12px;border-radius:8px;font-size:12px;font-weight:700;transition:all .2s;border:none}
.tbl-btn.promote{background:rgba(245,158,11,.15);color:var(--gold2);border:1px solid rgba(245,158,11,.3)}
.tbl-btn.promote:hover{background:rgba(245,158,11,.25)}
.tbl-btn.demote{background:rgba(100,116,139,.15);color:var(--muted);border:1px solid var(--border)}
.tbl-btn.demote:hover{background:rgba(100,116,139,.25)}
.tbl-btn.del{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.2)}
.tbl-btn.del:hover{background:rgba(239,68,68,.2)}
.tbl-btn.toggle-on{background:rgba(34,197,94,.1);color:#4ade80;border:1px solid rgba(34,197,94,.2)}
.tbl-btn.toggle-on:hover{background:rgba(34,197,94,.2)}
.tbl-btn.toggle-off{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.2)}
.tbl-btn.toggle-off:hover{background:rgba(239,68,68,.2)}
.tbl-btn.edit{background:rgba(59,130,246,.1);color:#60a5fa;border:1px solid rgba(59,130,246,.2)}
.tbl-btn.edit:hover{background:rgba(59,130,246,.2)}

/* ─── ADMIN VIP REVENUE ─── */
.revenue-summary{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:24px}
.rev-card{background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);border-radius:14px;padding:16px;text-align:center}
.rev-card .rev-val{font-size:28px;font-weight:900;color:var(--gold2);font-family:'Orbitron',sans-serif}
.rev-card .rev-label{font-size:12px;color:var(--muted);margin-top:4px}

/* ─── ADMIN GAME FORM ─── */
.admin-form{background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:16px;padding:24px;margin-top:20px}
.admin-form h3{font-size:16px;font-weight:800;margin-bottom:18px}
.admin-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.admin-form-grid{grid-template-columns:1fr}}
.admin-form .form-group label{color:var(--muted2)}
.admin-form-actions{display:flex;gap:10px;margin-top:20px}
.btn-save{padding:10px 24px;border-radius:10px;font-size:14px;font-weight:800;color:#fff;background:linear-gradient(135deg,#22c55e,#16a34a);border:none;transition:opacity .2s;}
.btn-save:hover{opacity:.85}
.btn-cancel{padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;color:var(--muted);background:rgba(30,41,59,.8);border:1px solid var(--border);transition:all .2s;}
.btn-cancel:hover{color:var(--text)}
.toggle-switch{display:flex;align-items:center;gap:10px;padding:12px 14px;background:rgba(30,41,59,.5);border:1px solid var(--border);border-radius:12px;cursor:pointer}
.toggle-track{width:40px;height:22px;border-radius:99px;background:var(--bg3);border:1px solid var(--border);position:relative;transition:background .2s;flex-shrink:0}
.toggle-track.on{background:rgba(34,197,94,.3);border-color:rgba(34,197,94,.5)}
.toggle-thumb{width:16px;height:16px;border-radius:50%;background:var(--muted2);position:absolute;top:2px;left:2px;transition:all .2s}
.toggle-track.on .toggle-thumb{left:20px;background:#4ade80}
.toggle-label{font-size:13px;font-weight:700}

/* ─── SNAKE ─── */
#snakeWrap{display:flex;flex-direction:column;align-items:center;gap:14px;user-select:none}
.snake-stats{display:flex;gap:28px;width:100%;max-width:420px;justify-content:space-between;padding:0 4px}
.snake-stat{text-align:center}
.snake-stat label{font-size:10px;color:var(--muted2);text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:2px}
.snake-stat span{font-size:30px;font-weight:900;display:block}
.sstat-score{color:var(--green)}.sstat-best{color:var(--yellow)}.sstat-len{color:var(--cyan)}
.canvas-wrap{position:relative;border-radius:16px;overflow:hidden;border:2px solid var(--border);box-shadow:0 0 40px rgba(34,197,94,.1)}
#snakeCanvas{display:block}
.canvas-overlay{position:absolute;inset:0;background:rgba(15,23,42,.87);backdrop-filter:blur(4px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;}
.canvas-overlay.hide{display:none}
.overlay-emoji{font-size:52px}
.overlay-title{font-size:28px;font-weight:900;font-family:'Orbitron',sans-serif}
.overlay-sub{font-size:14px;color:var(--muted);margin-top:4px}
.btn-start{padding:14px 36px;border-radius:14px;font-size:17px;font-weight:900;color:#fff;background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 6px 24px rgba(34,197,94,.35);transition:opacity .2s,transform .1s;}
.btn-start:hover{opacity:.9}.btn-start:active{transform:scale(.96)}
.dpad{display:flex;flex-direction:column;align-items:center;gap:4px}
.dpad-row{display:flex;gap:4px}
.dpad-btn{width:52px;height:52px;background:rgba(30,41,59,.9);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:20px;display:flex;align-items:center;justify-content:center;transition:background .15s,transform .1s;-webkit-tap-highlight-color:transparent;}
.dpad-btn:active{background:var(--border);transform:scale(.93)}
.snake-actions{display:flex;gap:10px}
.btn-sm{padding:8px 18px;border-radius:10px;font-size:13px;font-weight:700;color:#fff;background:rgba(30,41,59,.9);border:1px solid var(--border);transition:background .15s;}
.btn-sm:hover{background:var(--border)}

/* ─── GRADIENTS ─── */
.g-snake{background:linear-gradient(135deg,#22c55e,#059669)}
.g-tetris{background:linear-gradient(135deg,#3b82f6,#4338ca)}
.g-pong{background:linear-gradient(135deg,#f97316,#d97706)}
.g-memory{background:linear-gradient(135deg,#a855f7,#7c3aed)}
.g-space{background:linear-gradient(135deg,#06b6d4,#0284c7)}
.g-flappy{background:linear-gradient(135deg,#eab308,#f97316)}
.g-vip1{background:linear-gradient(135deg,#f59e0b,#d97706)}
.g-vip2{background:linear-gradient(135deg,#ec4899,#a855f7)}
.t-snake{background:linear-gradient(160deg,rgba(34,197,94,.55),rgba(5,150,105,.55))}
.t-tetris{background:linear-gradient(160deg,rgba(59,130,246,.55),rgba(67,56,202,.55))}
.t-pong{background:linear-gradient(160deg,rgba(249,115,22,.55),rgba(217,119,6,.55))}
.t-memory{background:linear-gradient(160deg,rgba(168,85,247,.55),rgba(124,58,237,.55))}
.t-space{background:linear-gradient(160deg,rgba(6,182,212,.55),rgba(2,132,199,.55))}
.t-flappy{background:linear-gradient(160deg,rgba(234,179,8,.55),rgba(249,115,22,.55))}
.t-vip1{background:linear-gradient(160deg,rgba(245,158,11,.55),rgba(217,119,6,.55))}
.t-vip2{background:linear-gradient(160deg,rgba(236,72,153,.55),rgba(168,85,247,.55))}

/* ─── TOAST ─── */
#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--bg3);border:1px solid var(--border);border-radius:14px;padding:12px 20px;font-size:14px;font-weight:600;color:var(--text);box-shadow:0 12px 40px rgba(0,0,0,.4);transition:transform .3s cubic-bezier(.34,1.56,.64,1);z-index:999;white-space:nowrap;}
#toast.show{transform:translateX(-50%) translateY(0)}
#toast.success{border-color:var(--green);color:var(--green)}
#toast.vip-toast{border-color:var(--gold);color:var(--gold2)}
#toast.admin-toast{border-color:#ef4444;color:#f87171}
</style>
</head>
<body>

<!-- ══════════ HEADER ══════════ -->
<header>
  <div class="header-inner">
    <div class="logo">
      <div class="logo-icon">🎮</div>
      <div class="logo-text">
        <h1>GameZone</h1>
        <p>Mini juegos web</p>
      </div>
    </div>
    <div class="search-wrap">
      <span class="search-icon">🔍</span>
      <input id="searchInput" type="text" placeholder="Buscar juegos..." autocomplete="off" />
      <button id="clearSearch" class="hidden">✕</button>
    </div>
    <button id="availableBtn">⚡ Disponibles</button>
    <div class="header-auth" id="headerAuth">
      <button class="btn-login" onclick="openAuthModal('login')">Iniciar sesión</button>
      <button class="btn-register" onclick="openAuthModal('register')">Registrarse</button>
    </div>
    <div class="header-auth hidden" id="headerProfile" style="position:relative">
      <button class="profile-btn" onclick="toggleDropdown()">
        <div class="profile-avatar" id="profileAvatar">?</div>
        <div>
          <div class="profile-name" id="profileName">Usuario</div>
          <div class="profile-role" id="profileRole">Free</div>
        </div>
        <span class="profile-chevron">▾</span>
      </button>
      <div class="profile-dropdown hidden" id="profileDropdown">
        <div class="dropdown-user">
          <div class="dropdown-user-name" id="dropdownName">Usuario</div>
          <div class="dropdown-user-email" id="dropdownEmail">email@ejemplo.com</div>
          <div id="dropdownVipBadge" class="hidden"><span class="dropdown-vip-badge">👑 VIP ACTIVO</span></div>
          <div id="dropdownAdminBadge" class="hidden"><span class="dropdown-admin-badge">🛡️ ADMINISTRADOR</span></div>
        </div>
        <button class="dropdown-item admin-item hidden" id="adminPanelBtn" onclick="openAdminPanel();toggleDropdown()">🛡️ Panel de Administración</button>
        <button class="dropdown-item" onclick="openVipModal();toggleDropdown()">👑 Membresía VIP</button>
        <div class="dropdown-sep"></div>
        <button class="dropdown-item danger" onclick="logout()">🚪 Cerrar sesión</button>
      </div>
    </div>
  </div>
</header>

<!-- ══════════ MAIN ══════════ -->
<main>
  <section class="hero">
    <div class="hero-img">
      <div class="hero-stars"></div>
      <div class="hero-controller">🎮</div>
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <p class="hero-label">Bienvenido a</p>
      <h2 class="hero-title">GameZone</h2>
      <p class="hero-sub">Tu colección de mini juegos clásicos. ¡Juega directo en el navegador, sin descargas!</p>
      <div class="hero-stats">
        <div class="hero-stat-live">
          <div class="dot-live pulse"></div>
          <span id="availableCount">1 juego disponible</span>
        </div>
        <div style="font-size:13px;color:var(--muted2)" id="devCount">5 en desarrollo</div>
      </div>
    </div>
  </section>

  <div id="vipBannerContainer"></div>
  <div class="pills" id="pillsContainer"></div>
  <div class="results-header">
    <h3 id="resultsTitle">Todos los juegos</h3>
    <p id="resultsCount">6 juegos encontrados</p>
  </div>
  <div id="gameGrid"></div>
  <div id="emptyState">
    <p class="big">🎮</p>
    <h3>No se encontraron juegos</h3>
    <p class="sub">Intenta con otro término de búsqueda o categoría</p>
    <button onclick="clearFilters()">Limpiar filtros</button>
  </div>
  <section id="quickPlay">
    <h3>⚡ Jugar ahora <span>— Juegos disponibles</span></h3>
    <div class="quick-grid" id="quickGrid"></div>
  </section>
</main>

<footer>
  <p>🎮 GameZone · Mini juegos clásicos en el navegador</p>
  <p>Más juegos llegando pronto...</p>
</footer>

<!-- ══════════ GAME MODAL ══════════ -->
<div id="modalBackdrop">
  <div class="modal" id="modalBox">
    <div class="modal-header" id="modalHeader">
      <div class="modal-header-left">
        <span class="modal-emoji" id="modalEmoji"></span>
        <div>
          <div class="modal-title" id="modalTitle"></div>
          <div class="modal-cat" id="modalCat"></div>
        </div>
      </div>
      <button class="modal-close" id="modalClose">✕</button>
    </div>
    <div class="modal-how" id="modalHow"></div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<!-- ══════════ AUTH MODAL ══════════ -->
<div id="authBackdrop" style="display:none;position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.85);backdrop-filter:blur(14px);align-items:center;justify-content:center;padding:16px">
  <div class="auth-modal">
    <div class="auth-header">
      <div class="auth-icon">🎮</div>
      <h2 id="authTitle">Bienvenido</h2>
      <p id="authSubtitle">Inicia sesión para guardar tu progreso</p>
    </div>
    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLogin" onclick="switchAuthTab('login')">Iniciar sesión</button>
      <button class="auth-tab" id="tabRegister" onclick="switchAuthTab('register')">Registrarse</button>
    </div>
    <div class="auth-form" id="loginForm">
      <div class="form-group">
        <label>Email</label>
        <input type="email" id="loginEmail" placeholder="tu@email.com" />
      </div>
      <div class="form-group">
        <label>Contraseña</label>
        <input type="password" id="loginPassword" placeholder="••••••••" />
        <div class="form-error" id="loginError"></div>
      </div>
      <button class="btn-auth" onclick="doLogin()">Entrar al GameZone ▶</button>
      <div class="auth-switch">¿No tienes cuenta? <button onclick="switchAuthTab('register')">Regístrate gratis</button></div>
      <p style="font-size:11px;color:var(--muted2);text-align:center;margin-top:12px">Admin: admin@gamezone.com / admin123</p>
    </div>
