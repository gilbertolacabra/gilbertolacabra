/* ─── SNAKE ─── */
const CELL=20,COLS=20,ROWS=20,W=CELL*COLS,H=CELL*ROWS;
let snakeState=null,snakeInterval=null,snakeKeyHandler=null;
function snakeHTML(){return `<div id="snakeWrap"><div class="snake-stats"><div class="snake-stat"><label>Score</label><span class="sstat-score" id="sScore">0</span></div><div class="snake-stat"><label>Best</label><span class="sstat-best" id="sBest">0</span></div><div class="snake-stat"><label>Length</label><span class="sstat-len" id="sLen">3</span></div></div><div class="canvas-wrap"><canvas id="snakeCanvas" width="${W}" height="${H}"></canvas><div class="canvas-overlay" id="snakeOverlay"><div class="overlay-emoji">🐍</div><div class="overlay-title" style="color:#22c55e">Snake</div><div class="overlay-sub">Usa las flechas / WASD para moverte</div><button class="btn-start" id="snakeStartBtn">▶ Comenzar</button></div></div><div class="dpad"><div class="dpad-row"><button class="dpad-btn" id="dUp">▲</button></div><div class="dpad-row"><button class="dpad-btn" id="dLeft">◀</button><button class="dpad-btn" id="dDown">▼</button><button class="dpad-btn" id="dRight">▶</button></div></div><div class="snake-actions" id="snakeActions" style="display:none"><button class="btn-sm" id="snakePauseBtn">⏸ Pausar</button><button class="btn-sm" id="snakeRestartBtn">🔄 Reiniciar</button></div></div>`;}
function initSnake(){const hs=parseInt(localStorage.getItem('snake-highscore')||'0');snakeState={snake:[{x:10,y:10},{x:9,y:10},{x:8,y:10}],food:{x:15,y:10},dir:'RIGHT',pending:'RIGHT',score:0,highScore:hs,speed:150,status:'idle'};updateSnakeUI();drawSnake();document.getElementById('snakeStartBtn').addEventListener('click',startSnake);document.getElementById('dUp').addEventListener('pointerdown',()=>dpadPress('UP'));document.getElementById('dDown').addEventListener('pointerdown',()=>dpadPress('DOWN'));document.getElementById('dLeft').addEventListener('pointerdown',()=>dpadPress('LEFT'));document.getElementById('dRight').addEventListener('pointerdown',()=>dpadPress('RIGHT'));document.getElementById('snakePauseBtn').addEventListener('click',togglePause);document.getElementById('snakeRestartBtn').addEventListener('click',startSnake);snakeKeyHandler=e=>{const map={ArrowUp:'UP',ArrowDown:'DOWN',ArrowLeft:'LEFT',ArrowRight:'RIGHT',w:'UP',W:'UP',s:'DOWN',S:'DOWN',a:'LEFT',A:'LEFT',d:'RIGHT',D:'RIGHT'};if(map[e.key]){e.preventDefault();snakeState.pending=map[e.key]}if(e.key===' '){e.preventDefault();togglePause()}};window.addEventListener('keydown',snakeKeyHandler);}
function destroySnake(){if(snakeInterval)clearInterval(snakeInterval);if(snakeKeyHandler)window.removeEventListener('keydown',snakeKeyHandler);snakeState=snakeInterval=snakeKeyHandler=null}
function dpadPress(dir){if(!snakeState)return;snakeState.pending=dir;if(snakeState.status==='idle'||snakeState.status==='over')startSnake()}
function togglePause(){if(!snakeState)return;if(snakeState.status==='running'){snakeState.status='paused';clearInterval(snakeInterval);showOverlay('paused')}else if(snakeState.status==='paused'){snakeState.status='running';hideOverlay();snakeInterval=setInterval(snakeLoop,snakeState.speed)}}
function startSnake(){if(!snakeState)return;clearInterval(snakeInterval);Object.assign(snakeState,{snake:[{x:10,y:10},{x:9,y:10},{x:8,y:10}],food:{x:15,y:10},dir:'RIGHT',pending:'RIGHT',score:0,speed:150,status:'running'});hideOverlay();document.getElementById('snakeActions').style.display='flex';updateSnakeUI();drawSnake();snakeInterval=setInterval(snakeLoop,snakeState.speed);}
function snakeLoop(){const s=snakeState;if(!s||s.status!=='running')return;const opp={UP:'DOWN',DOWN:'UP',LEFT:'RIGHT',RIGHT:'LEFT'};if(s.pending!==opp[s.dir])s.dir=s.pending;const head=s.snake[0];const next={x:head.x+(s.dir==='RIGHT'?1:s.dir==='LEFT'?-1:0),y:head.y+(s.dir==='DOWN'?1:s.dir==='UP'?-1:0)};if(next.x<0||next.x>=COLS||next.y<0||next.y>=ROWS)return gameOver();if(s.snake.some(p=>p.x===next.x&&p.y===next.y))return gameOver();s.snake.unshift(next);if(next.x===s.food.x&&next.y===s.food.y){s.score+=10;if(s.score>s.highScore){s.highScore=s.score;localStorage.setItem('snake-highscore',s.highScore)}s.speed=Math.max(60,s.speed-2);clearInterval(snakeInterval);snakeInterval=setInterval(snakeLoop,s.speed);s.food=randomSnakeFood(s.snake);}else{s.snake.pop()}updateSnakeUI();drawSnake();}
function gameOver(){const s=snakeState;s.status='over';clearInterval(snakeInterval);showOverlay('over',s.score,s.score>0&&s.score>=s.highScore)}
function randomSnakeFood(snake){let p;do{p={x:Math.floor(Math.random()*COLS),y:Math.floor(Math.random()*ROWS)}}while(snake.some(s=>s.x===p.x&&s.y===p.y));return p}
function updateSnakeUI(){const s=snakeState;if(!s)return;const el=id=>document.getElementById(id);if(el('sScore'))el('sScore').textContent=s.score;if(el('sBest'))el('sBest').textContent=s.highScore;if(el('sLen'))el('sLen').textContent=s.snake.length;}
function showOverlay(type,score=0,isRecord=false){const ov=document.getElementById('snakeOverlay');if(!ov)return;ov.classList.remove('hide');if(type==='idle'){ov.innerHTML=`<div class="overlay-emoji">🐍</div><div class="overlay-title" style="color:#22c55e">Snake</div><div class="overlay-sub">Usa las flechas / WASD para moverte</div><button class="btn-start" id="snakeStartBtn">▶ Comenzar</button>`;document.getElementById('snakeStartBtn').addEventListener('click',startSnake);}else if(type==='over'){ov.innerHTML=`<div class="overlay-emoji">💀</div><div class="overlay-title" style="color:#ef4444">Game Over</div><div class="overlay-sub">Puntuación: ${score}</div>${isRecord?`<div style="color:#eab308;font-weight:700;font-size:14px">🏆 ¡Nuevo récord!</div>`:''}<button class="btn-start" id="snakeStartBtn">Jugar de nuevo</button>`;document.getElementById('snakeStartBtn').addEventListener('click',startSnake);}else if(type==='paused'){ov.innerHTML=`<div class="overlay-emoji">⏸</div><div class="overlay-title" style="color:#eab308">Pausado</div><button class="btn-start" id="snakeResumeBtn">Continuar</button>`;document.getElementById('snakeResumeBtn').addEventListener('click',togglePause);}}
function hideOverlay(){const ov=document.getElementById('snakeOverlay');if(ov)ov.classList.add('hide')}
function drawSnake(){const canvas=document.getElementById('snakeCanvas');if(!canvas||!snakeState)return;const ctx=canvas.getContext('2d');const{snake,food,dir}=snakeState;ctx.fillStyle='#0f172a';ctx.fillRect(0,0,W,H);ctx.strokeStyle='rgba(255,255,255,0.03)';ctx.lineWidth=.5;for(let x=0;x<=COLS;x++){ctx.beginPath();ctx.moveTo(x*CELL,0);ctx.lineTo(x*CELL,H);ctx.stroke()}for(let y=0;y<=ROWS;y++){ctx.beginPath();ctx.moveTo(0,y*CELL);ctx.lineTo(W,y*CELL);ctx.stroke()}snake.forEach((seg,i)=>{const ratio=i/snake.length;const g=Math.floor(220-ratio*80);const b=Math.floor(100+ratio*60);ctx.fillStyle=i===0?'#22c55e':`rgb(20,${g},${b})`;const pad=i===0?1:2;ctx.beginPath();ctx.roundRect(seg.x*CELL+pad,seg.y*CELL+pad,CELL-pad*2,CELL-pad*2,i===0?6:4);ctx.fill();if(i===0){ctx.fillStyle='#0f172a';const eyeR=3;if(dir==='RIGHT'||dir==='LEFT'){const ex=dir==='RIGHT'?seg.x*CELL+CELL-6:seg.x*CELL+4;ctx.beginPath();ctx.arc(ex,seg.y*CELL+5,eyeR,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(ex,seg.y*CELL+CELL-5,eyeR,0,Math.PI*2);ctx.fill();}else{const ey=dir==='DOWN'?seg.y*CELL+CELL-6:seg.y*CELL+4;ctx.beginPath();ctx.arc(seg.x*CELL+5,ey,eyeR,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(seg.x*CELL+CELL-5,ey,eyeR,0,Math.PI*2);ctx.fill();}}});const grd=ctx.createRadialGradient(food.x*CELL+CELL/2,food.y*CELL+CELL/2,2,food.x*CELL+CELL/2,food.y*CELL+CELL/2,CELL/2);grd.addColorStop(0,'#fbbf24');grd.addColorStop(1,'#ef4444');ctx.shadowColor='#ef4444';ctx.shadowBlur=14;ctx.fillStyle=grd;ctx.beginPath();ctx.arc(food.x*CELL+CELL/2,food.y*CELL+CELL/2,CELL/2-2,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;}

